package requests;

import static io.restassured.RestAssured.*;
import static org.hamcrest.Matchers.*;

import org.testng.annotations.Test;

public class Payload_Pojo {	

	@Test
	void createProduct()
	{
		Payload_Pojo_Data data=new Payload_Pojo_Data();
		data.setYear(2025);
		data.setPrice(2025.25);
		data.setCpuModel("Intel Core i9");
		data.setHardDiskSize("1 TB");
		
		Payload_Pojo_Laptop_Name laptopName=new Payload_Pojo_Laptop_Name();
		laptopName.setName("Apple MacBook Pro 16");
		laptopName.setData(data);
		
		given()
			.contentType("application/json")
			.body(laptopName)	
			.log().body()
		
		.when()
			.post("https://api.restful-api.dev/objects")		
		
		.then()
			.statusCode(200)
			.log().all()	
		    .body("data.year", equalTo(2025));
		
	}

}
