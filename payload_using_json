package requests;

import static io.restassured.RestAssured.given;
import static org.hamcrest.Matchers.equalTo;

import java.util.HashMap;

import org.json.JSONObject;

public class Payload_USing_JSON {
	
	public void createRecord()
	{
		JSONObject data = new JSONObject();// Changes 1 compare to HashMap
		data.put("year", 2019);
		data.put("price", 1849.99);
		data.put("CPU model", "Intel Core i9");
		data.put("Hard disk size", "1 TB");
		
		JSONObject laptop_name = new JSONObject(); // Changes 2 compare to HashMap
		laptop_name.put("name", "Apple MacBook Pro 16");
		laptop_name.put("data", data);
		
		given()
			.contentType("application/json")
			.body(laptop_name.toString()) // Changes 3 compare to HashMap
		
		.when()
			.post("https://api.restful-api.dev/objects")		
		
		.then()
			.statusCode(200)
			.body("data.year",equalTo(2019) )
			.log().all();		
		
	}

}

