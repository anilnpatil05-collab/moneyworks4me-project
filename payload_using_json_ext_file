package requests;

import static io.restassured.RestAssured.given;
import static org.hamcrest.Matchers.equalTo;

import java.io.File;
import java.io.FileNotFoundException;
import java.io.FileReader;

import org.json.JSONObject;
import org.json.JSONTokener;

public class Paylod_Using_JSONFile {
	
	public void createRecord() throws FileNotFoundException
	{
		//Following changes compare to JSON Library
		File f=new File(".//post_request.json");
		FileReader fin=new FileReader(f);
		JSONTokener token=new JSONTokener(fin);
		JSONObject laptop_name=new JSONObject(token);
		
		given()
			.contentType("application/json")
			.body(laptop_name.toString())
		
		.when()
			.post("https://api.restful-api.dev/objects")		
		
		.then()
			.statusCode(200)
			.body("data.year",equalTo(2019) )
			.log().all();		
		
	}

}
